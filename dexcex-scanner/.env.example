# Copy to .env and fill in what you need. Never commit .env.

# NATS (local compose maps host 4223 → container 4222)
NATS_URL=nats://localhost:4222

# DEX prices: DeFiLlama by default. Set AGGREGATOR_URL for a custom JSON feed.
DEX_AGGREGATOR_TYPE=defillama
DEX_AGGREGATOR_URL=
DEX_AGGREGATOR_POLL_MS=15000

# Optional keyed RPCs for the gateway / indexer (comma-separated = fallbacks).
# Public endpoints are built in; they rate-limit. Alchemy / Infura / QuickNode recommended.
RPC_ETHEREUM=
RPC_BSC=
RPC_ARBITRUM=
RPC_POLYGON=
RPC_BASE=
RPC_OPTIMISM=
RPC_AVALANCHE=

# Signal filters
MIN_SPREAD_PCT=0.5
MIN_LIQUIDITY_USD=100
TOP_N_PER_CHAIN=10
MAX_RISK_SCORE=50
RISK_THRESHOLD=50
SLIPPAGE_TRADE_USD=1000

# CEX websockets (no API keys required for public tickers)
EXCHANGES=binance,mexc,gate,bybit,kucoin,okx
CEX_EXCHANGES=binance,mexc,gate,bybit,kucoin,okx

# API
PORT=3002
CORS_ORIGINS=

# Optional: override default compose DB password
DEXCEX_POSTGRES_PASSWORD=dexcex
